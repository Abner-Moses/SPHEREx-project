# Reproducible environments, validation tooling and generated artifacts
.venv/
.audit/
node_modules/
frontend/dist/
__pycache__/
.pytest_cache/
.cache/
.DS_Store
.env
.env.*
!.env.example
# Generated FITS stay ignored; the original dataset is versioned with Git LFS.
*.fits
*.fits.gz
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal
science/cache/observations/
science/cache/hips/

# Original uploaded dataset (large FITS use .gitattributes / Git LFS).
!SphereX-data/**/*.fits
!SphereX-data/**/*.log
