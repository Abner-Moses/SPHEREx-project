# Backend runtime configuration. No secrets belong in browser build variables.
SPHEREX_FIREFLY_LOADER=/firefly/firefly_loader.js
SPHEREX_FIREFLY_FITS_BASE=http://host.docker.internal:8000
SPHEREX_CACHE=cache/observations
SPHEREX_HIPS_CACHE=cache/hips
SPHEREX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local products stay outside the repository; use 0 for online fallback.
SPHEREX_DATA_ROOT=~/SphereX-data
SPHEREX_OFFLINE=1
